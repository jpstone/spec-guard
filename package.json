{
  "name": "@jpstone/spec-guard",
  "version": "2.0.0",
  "description": "Spec-first, behavior-tested, agent-safe methodology, workflow runner, and MCP server.",
  "type": "module",
  "bin": {
    "spec-guard": "bin/spec-guard.js",
    "spec-guard-mcp": "mcp/server.js"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "WORKFLOW.md",
    "docs/",
    "bin/",
    "src/",
    "mcp/",
    "templates/",
    "examples/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check:example": "node bin/spec-guard.js check test/fixtures/valid-spec.md",
    "run:example": "node bin/spec-guard.js run --check-only test/fixtures/valid-spec.md"
  },
  "keywords": [
    "spec-first",
    "tdd",
    "ai-agents",
    "methodology",
    "contracts",
    "agent-safe",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpstone/spec-guard.git"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
